# 氚云引擎配置模板
# 用法: 复制本文件为 .env 并填入真实值 (.env 已被 .gitignore 排除, 不会提交到 git)
# 凭证获取: 氚云后台 -> 系统集成 -> 企业开发信息 (Secret 泄露时在后台重置)

# 引擎编码 (必填)
H3YUN_ENGINE_CODE=your_engine_code

# 引擎密钥 (必填)
H3YUN_SECRET=your_secret

# API基础URL (可选, 默认 https://www.h3yun.com)
#H3YUN_BASE_URL=https://www.h3yun.com

# 请求超时秒数 (可选, 默认 30)
#H3YUN_TIMEOUT=30
